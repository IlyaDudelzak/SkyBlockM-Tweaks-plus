{
  "schemaVersion": 1,
  "id": "skyblockm-tweaks",
  "version": "${version}",

  "name": "SkyBlockM Tweaks+",
  "description": "Fork SkyBlockM Tweaks (DespairScent) with AI Captcha Solver & performance fixes",
  "authors": [
    "Ilya Dudelzak (Fork & AI Solver)",
    "DespairScent (Original Author)"
  ],
  "contact": {
    "homepage": "https://github.com/IlyaDudelzak/SkyBlockM-Tweaks-plus",
    "sources": "https://github.com/IlyaDudelzak/SkyBlockM-Tweaks-plus"
  },

  "license": "MIT",
  "icon": "assets/skyblockm-tweaks/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "despairscent.skyblockm.tweaks.ModLoader"
    ],
    "modmenu": [
      "despairscent.skyblockm.tweaks.config.ModMenuImplementation"
    ]
  },
  "mixins": [
    "skyblockm-tweaks.mixins.json"
  ],
  "accessWidener": "skyblockm-tweaks.accesswidener",

  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "*",
    "fabric-api": "*"
  },
  "recommends": {
    "modmenu": "*",
    "cloth-config2": "*"
  }
}
